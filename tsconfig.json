{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "eslint.config.js",
    "src/App.tsx",
    "src/App.css",
    "src/main.tsx",
    "src/index.css",
    "src/vite-env.d.ts",
    "src/pages",
    "src/assets",
    "src/hooks/use-toast.ts",
    "src/hooks/use-mobile.tsx",
    "src/components/CTA.tsx",
    "src/components/Features.tsx",
    "src/components/Footer.tsx",
    "src/components/Hero.tsx",
    "src/components/HowItWorks.tsx",
    "src/components/Impact.tsx",
    "src/components/NavLink.tsx",
    "src/components/Navbar.tsx",
    "src/components/Pricing.tsx",
    "src/components/WasteEducation.tsx",
    "src/components/ui"
  ]
}
